---
import Base from "../layouts/Base.astro";
import { resume } from "../data/resume";

const {
  name,
  tagline,
  contact,
  summary,
  experience,
  skills,
  education,
  other,
  pdfFileName,
} = resume;
---

<Base>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --ink: #1a1916;
        --ink2: #4a4845;
        --ink3: #7a7875;
        --rule: #d8d5ce;
        --page: #faf9f6;
        --shell: #e8e5de;
        --serif: Georgia, "Times New Roman", serif;
        --mono: "DM Mono", monospace;
      }

      body {
        background: var(--shell);
        font-family: var(--serif);
        color: var(--ink);
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Shell */
      .shell {
        padding: 24px 16px 48px;
      }

      .print-bar {
        width: 210mm;
        max-width: 100%;
        margin: 0 auto 10px;
        text-align: right;
      }

      .print-bar button {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        background: var(--ink);
        color: var(--page);
        border: none;
        padding: 7px 16px;
        cursor: pointer;
        border-radius: 2px;
        transition: opacity 0.15s;
      }
      .print-bar button:hover {
        opacity: 0.7;
      }

      /* Page */
      .page {
        width: 210mm;
        max-width: 100%;
        margin: 0 auto;
        background: var(--page);
        padding: 14mm 16mm 12mm;
      }

      /* Header */
      header {
        border-bottom: 1.5px solid var(--ink);
        padding-bottom: 8px;
        margin-bottom: 8pt;
      }

      .header-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
      }

      h1 {
        font-family: var(--serif);
        font-size: 22pt;
        font-weight: 400;
        letter-spacing: 0.02em;
        line-height: 1;
      }

      .tagline {
        font-family: var(--mono);
        font-size: 8.5pt;
        color: var(--ink3);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-top: 5px;
      }

      address {
        font-style: normal;
        font-family: var(--mono);
        font-size: 8.5pt;
        color: var(--ink2);
        letter-spacing: 0.04em;
        line-height: 1.45;
        text-align: right;
        display: grid;
        grid-template-columns: auto auto;
        column-gap: 14pt;
        justify-items: end;
      }

      address a {
        color: var(--ink2);
        text-decoration: none;
      }
      address a:hover {
        color: var(--ink);
        text-decoration: underline;
      }

      /* Summary */
      .summary {
        font-size: 10pt;
        line-height: 1.35;
        color: var(--ink2);
        margin-bottom: 8pt;
        padding-bottom: 2pt;
        /* border-bottom: 0.5px solid var(--rule); */
      }

      /* Sections */
      section {
        margin-bottom: 8pt;
      }
      section:last-child {
        margin-bottom: 0;
      }

      .section-head {
        font-family: var(--mono);
        font-weight: 400;
        font-size: 10.5pt;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink3);
        margin-bottom: 5pt;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .section-head::after {
        content: "";
        flex: 1;
        height: 0.5px;
        background: var(--rule);
      }

      /* Experience */
      .role {
        margin-bottom: 8pt;
      }

      .role-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1px;
      }

      .role-title {
        font-size: 11pt;
        font-weight: 500;
      }

      .role-date {
        font-family: var(--mono);
        font-size: 9pt;
        color: var(--ink3);
        letter-spacing: 0.05em;
      }

      .role-company {
        font-size: 10pt;
        color: var(--ink2);
        font-style: italic;
        margin-bottom: 3pt;
      }

      ul {
        list-style: none;
      }

      li {
        font-size: 10pt;
        line-height: 1.32;
        color: var(--ink2);
        padding-left: 14px;
        text-indent: -14px;
        margin-bottom: 1pt;
      }
      li::before {
        content: "—";
        display: inline-block;
        width: 14px;
        text-indent: 0;
        color: var(--ink3);
        font-size: 9pt;
      }

      /* Skills */
      .skills-grid {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 3pt 12pt;
        align-items: baseline;
      }
      .skills-grid > div {
        display: contents;
      }

      .skill-label {
        font-family: var(--mono);
        font-size: 8.5pt;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink3);
      }

      .skill-items {
        font-size: 10pt;
        color: var(--ink2);
        line-height: 1.32;
      }

      /* Education */
      .edu-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1px;
      }

      .edu-deg {
        font-size: 10.5pt;
        font-weight: 500;
      }
      .edu-date {
        font-family: var(--mono);
        font-size: 9pt;
        color: var(--ink3);
      }
      .edu-inst {
        font-size: 10pt;
        color: var(--ink2);
        font-style: italic;
        margin-bottom: 4pt;
      }

      /* Other */
      .other-row {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 3pt 12pt;
        align-items: baseline;
      }
      .other-item {
        display: contents;
      }
      .other-title {
        font-size: 10.5pt;
        font-weight: 500;
      }
      .other-sub {
        font-size: 10pt;
        color: var(--ink2);
        font-style: italic;
        line-height: 1.32;
      }

      /* Print */
      @page {
        size: A4;
        margin: 0;
      }

      @media print {
        /* Plain white paper so leftover space reads as a normal margin */
        :root {
          --page: #ffffff;
        }
        html,
        body {
          background: var(--page);
          height: auto;
        }
        .shell {
          padding: 0;
        }
        .print-bar {
          display: none;
        }
        .page {
          width: 100%;
          padding: 8mm 12mm;
        }
      }
    </style>
  </Fragment>

  <div class="shell">
    <div class="print-bar">
      <button onclick="window.print()">⬇ Print / Save as PDF</button>
    </div>
    <script is:inline define:vars={{ pdfFileName }}>
      // Browsers name the saved PDF after document.title; swap it only while printing
      const pageTitle = document.title;
      addEventListener("beforeprint", () => (document.title = pdfFileName));
      addEventListener("afterprint", () => (document.title = pageTitle));
    </script>

    <div class="page">
      <header>
        <div class="header-top">
          <div>
            <h1>{name}</h1>
            <p class="tagline">{tagline}</p>
          </div>
          <address>
            <a href={`tel:${contact.phone.split(" ").join("")}`}
              >{contact.phone}</a
            >
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
            <a href={`https://${contact.website}`}>{contact.website}</a>
            <a href={`https://${contact.linkedin}`}>{contact.linkedin}</a>
            <a href={`https://${contact.github}`}>{contact.github}</a>
            <span>{contact.location}</span>
          </address>
        </div>
      </header>

      <p class="summary">{summary}</p>

      <!-- Experience -->
      <section>
        <h2 class="section-head">Experience</h2>
        {
          experience.map((role) => (
            <div class="role">
              <div class="role-header">
                <span class="role-title">{role.title}</span>
                <span class="role-date">
                  {role.from} — {role.to}
                </span>
              </div>
              <p class="role-company">
                {role.company}, {role.location}
              </p>
              <ul>
                {role.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <!-- Skills -->
      <section>
        <h2 class="section-head">Skills</h2>
        <div class="skills-grid">
          {
            skills.map((s) => (
              <div>
                <p class="skill-label">{s.label}</p>
                <p class="skill-items">{s.items}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Education -->
      <section>
        <h2 class="section-head">Education</h2>
        {
          education.map((e) => (
            <div>
              <div class="edu-row">
                <span class="edu-deg">{e.degree}</span>
                <span class="edu-date">
                  {e.from} — {e.to}
                </span>
              </div>
              <p class="edu-inst">{e.institution}</p>
            </div>
          ))
        }
      </section>

      <!-- Other -->
      <section>
        <h2 class="section-head">Other</h2>
        <div class="other-row">
          {
            other.map((o) => (
              <div class="other-item">
                <p class="other-title">{o.title}</p>
                <p class="other-sub">{o.description}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Base>
